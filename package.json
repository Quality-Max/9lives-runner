{
  "name": "9lives-framework-workspace",
  "private": true,
  "workspaces": ["packages/playwright", "testdata/sdk"],
  "scripts": {
    "build": "npm run build --workspace @9l/playwright",
    "test": "npm run build && node --test packages/playwright/test/*.test.cjs internal/assessment/analyzer.test.cjs scripts/bundle-assessment-parser.test.cjs",
    "smoke": "npm run build && node scripts/sdk-smoke.cjs",
    "smoke:assessment": "node scripts/assessment-smoke.cjs",
    "smoke:assessment-portability": "node scripts/assessment-portability-smoke.cjs",
    "parser:check": "node scripts/bundle-assessment-parser.cjs --check"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
