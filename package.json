{
  "name": "9lives-framework-workspace",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": ["packages/playwright", "testdata/sdk"],
  "scripts": {
    "build": "npm run build --workspace @9l/playwright",
    "test": "npm run build && node --test packages/playwright/test/*.test.cjs internal/assessment/analyzer.test.cjs scripts/bundle-assessment-parser.test.cjs scripts/sdk-registry.test.cjs",
    "smoke": "npm run build && node scripts/sdk-smoke.cjs",
    "smoke:contracts": "npm run build && node scripts/contracts-smoke.cjs",
    "smoke:package": "npm run build && node scripts/package-smoke.cjs",
    "smoke:assessment": "node scripts/assessment-smoke.cjs",
    "smoke:prove": "npm run build && node scripts/prove-smoke.cjs",
    "smoke:confirm": "npm run build && node scripts/confirm-smoke.cjs",
    "smoke:visual": "npm run build && node scripts/visual-smoke.cjs",
    "smoke:assessment-portability": "node scripts/assessment-portability-smoke.cjs",
    "parser:check": "node scripts/bundle-assessment-parser.cjs --check",
    "demo": "npm run build && go run ./cmd/9l run testdata/sdk/tests/checkout.spec.ts --sdk --format json"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
