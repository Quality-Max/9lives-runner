{
  "$defs": {
    "AgentProvenance": {
      "properties": {
        "agent": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "repositorySHA256": {
          "type": "string"
        },
        "sourcePathSHA256": {
          "type": "string"
        },
        "sourceSHA256": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "version",
        "agent",
        "repositorySHA256",
        "branch",
        "commit",
        "sourceSHA256",
        "sourcePathSHA256"
      ],
      "type": "object"
    },
    "Finding": {
      "properties": {
        "classification": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "column": {
          "type": "integer"
        },
        "dimension": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "requirement": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "site": {
          "$ref": "#/$defs/Location"
        },
        "suggestion": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "classification",
        "dimension",
        "line",
        "column",
        "message",
        "suggestion",
        "code"
      ],
      "type": "object"
    },
    "Location": {
      "properties": {
        "column": {
          "type": "integer"
        },
        "line": {
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "type": "object"
    },
    "ProvenanceAssessment": {
      "properties": {
        "after": {
          "$ref": "#/$defs/AgentProvenance"
        },
        "before": {
          "$ref": "#/$defs/AgentProvenance"
        },
        "branch": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/AgentProvenance"
        },
        "repository": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "branch",
        "commit",
        "source",
        "repository"
      ],
      "type": "object"
    },
    "Report": {
      "properties": {
        "agentProvenance": {
          "$ref": "#/$defs/ProvenanceAssessment"
        },
        "compiler": {
          "type": "string"
        },
        "completeness": {
          "type": "string"
        },
        "execution": {
          "type": "string"
        },
        "limits": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "type": "string"
        },
        "requirementsSHA256": {
          "type": "string"
        },
        "sourceSHA256": {
          "type": "string"
        },
        "tests": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Test"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "unrecognizedTestImports": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "agentProvenance",
        "version",
        "policy",
        "sourceSHA256",
        "compiler",
        "execution",
        "completeness",
        "limits",
        "tests"
      ],
      "type": "object"
    },
    "SuiteFile": {
      "properties": {
        "error": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "report": {
          "$ref": "#/$defs/Report"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "SuiteSummary": {
      "properties": {
        "assessed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "files": {
          "type": "integer"
        },
        "findings": {
          "type": "integer"
        },
        "rules": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "tests": {
          "type": "integer"
        },
        "unrecognized": {
          "type": "integer"
        }
      },
      "required": [
        "files",
        "assessed",
        "failed",
        "unrecognized",
        "tests",
        "findings",
        "rules"
      ],
      "type": "object"
    },
    "Test": {
      "properties": {
        "column": {
          "type": "integer"
        },
        "dimensions": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Finding"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "type": "integer"
        },
        "requirements": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "line",
        "column",
        "requirements",
        "dimensions",
        "findings"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/Quality-Max/9lives-runner/blob/main/docs/contracts/assess-suite.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Advisory combined assessment of several files.",
  "properties": {
    "completeness": {
      "type": "string"
    },
    "execution": {
      "type": "string"
    },
    "files": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SuiteFile"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "type": "string"
    },
    "requirementsSHA256": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/SuiteSummary"
    },
    "version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "policy",
    "execution",
    "completeness",
    "files",
    "summary",
    "limits"
  ],
  "title": "9l assess \u003cseveral specs|dir|glob\u003e --format json",
  "type": "object"
}
